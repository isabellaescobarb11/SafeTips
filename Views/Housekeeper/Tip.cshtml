@{
    ViewData["Title"] = "Tip Page";
}

<div class="text-center mt-4">
    <h1>Tip Page</h1>

    <p>
        Please add in the tip amount that you want to leave and a message!
    </p>

    <form asp-controller="Housekeeper" asp-action="Tip" method="post">

        <input type="hidden" name="housekeeper" value="@ViewBag.Housekeeper" />

        <div class="mt-3">
            <label for="tip">Tip Amount: $</label>
            <input type="number" id="tip" name="tip" min="0" step="1" value="0">
        </div>

        <div class="mt-3">
            <label for="message">Message:</label>
            <br>
            <textarea id="message" name="message" rows="4" cols="40"
                      placeholder="Write a thank-you message..."></textarea>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">
                Send Tip
            </button>
        </div>

        <div>
            <h2>Thank you for tipping @ViewBag.Housekeeper!</h2>
            <p>Tip Amount: $@ViewBag.Tip</p>
            <p>Message: @ViewBag.Message</p>
        </div>

    </form>
</div>