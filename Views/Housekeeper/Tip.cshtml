@{
    ViewData["Title"] = "Tip Page";
}

<div class="text-center mt-4">
    <h1>Tip Page</h1>

    <p>
        Please add in the tip amount that you want to leave and a message!
    </p>

    <div class="mt-3">
        <label for="tip">Tip Amount: $</label>
        <input type="number" id="tip" name="tip" min="0" step="1" value="0">
    </div>

    <div class="mt-3">
        <label for="message">Message:</label>
        <br>
        <textarea id="message" name="message" rows="4" cols="40" placeholder="Write a thank-you message..."></textarea>
    </div>
</div>

<div class="text-center mt-4">
    <a class="btn btn-primary" asp-controller="Housekeeper" asp-action="Housekeepers">
        Send a Tip
    </a>
</div>
